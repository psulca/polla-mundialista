# Copia este archivo a .env.local y completa los valores.
# cp env.example .env.local

# --- Supabase ---
# Project URL y claves (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO servidor. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesión (teléfono + PIN) ---
# Secreto para firmar el JWT de sesión. Genera uno con: openssl rand -base64 32
SESSION_SECRET=

# --- Seed ---
# JSON de openfootball para sembrar equipos, fixtures y horarios.
OPENFOOTBALL_URL=https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json

# --- Marcadores en vivo (proveedor enchufable) ---
# Proveedor activo. Default: worldcup26ir (free, 500/min, hecho para el Mundial).
# Para volver a API-Football cuando se reactive: SCORE_PROVIDER=api-football
# SCORE_PROVIDER=worldcup26ir
#
# worldcup26.ir: los GET son públicos. Token opcional (válido 84 días) por si lo exigen:
# WORLDCUP26_TOKEN=
#
# API-Football (solo si SCORE_PROVIDER=api-football):
# FOOTBALL_API_KEY=
# FOOTBALL_API_LEAGUE=1

# Protege /api/sync y /api/reconcile en producción. DEBE llamarse CRON_SECRET:
# Vercel lo inyecta solo en los crons como Authorization: Bearer <valor>.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=
